<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>photon_server</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The API assembly and the plugin/mod sources live in sibling folders and
       must not be swept into the server's own compile by the SDK glob. -->
  <ItemGroup>
    <Compile Remove="api/**/*.cs" />
    <Compile Remove="mods/**/*.cs" />
    <Compile Remove="plugins/**/*.cs" />
    <Compile Remove="publish/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="api/PhotonServer.Api.csproj" />
  </ItemGroup>

</Project>
